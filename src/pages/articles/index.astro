---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const comingSoon = [
  {
    title: 'Letters of Credit – Bridges of Global Trust',
    description: 'Understanding the legal architecture behind trade finance.',
    category: 'Insurance Wordings',
    image: '/assets/brand-editorial-article-bg-v1.svg',
  },
];

const formatDate = (date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const readTime = (article) => `${Math.max(6, Math.ceil((article.body || '').split(/\s+/).filter(Boolean).length / 210))} min read`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Articles | Manoj Teja</title>
    <meta name="description" content="High-level articles on insurance, liability, wordings, specialty lines and cross-border risk from Dubai." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Articles | Manoj Teja" />
    <meta property="og:description" content="High-level articles on insurance, liability, wordings, specialty lines and cross-border risk." />
    <meta property="og:image" content="/assets/article-page-banner-19-may-2025.png" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </head>
  <body class="insights-page">
    <SiteHeader />
    <main class="insights-wrap">
      <div class="insights-header">
        <div>
          <p class="eyebrow">All articles</p>
          <h1>High-level perspectives for insurance professionals.</h1>
        </div>
        <a class="text-link" href="/">Back home →</a>
      </div>
      <div class="two-column">
        <section class="insight-list" aria-label="Article list">
          {articles.map((article) => (
            <article class="insight-row">
              <a href={`/articles/${article.id}/`}>
                <img src={article.data.featuredImage ?? '/assets/article-page-banner-19-may-2025.png'} alt="" />
              </a>
              <div>
                <p class="eyebrow">{article.data.category}</p>
                <h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2>
                {article.data.description && <p>{article.data.description}</p>}
                <div class="meta-row">
                  <span>{formatDate(article.data.date)}</span>
                  <span>{readTime(article)}</span>
                  {article.data.audio && <span>Audio available</span>}
                </div>
              </div>
              <a class="play-link" href={`/articles/${article.id}/`} aria-label={`Open ${article.data.title}`}>▶</a>
            </article>
          ))}
          {comingSoon.map((item) => (
            <article class="insight-row insight-row--soon" aria-label={`${item.title} coming soon`}>
              <img src={item.image} alt="" />
              <div>
                <p class="eyebrow">{item.category}</p>
                <h2>{item.title}</h2>
                <p>{item.description}</p>
                <div class="meta-row">
                  <span>Coming soon</span>
                  <span>In preparation</span>
                </div>
              </div>
              <span class="play-link">…</span>
            </article>
          ))}
        </section>
        <aside>
          <div class="side-card">
            <p class="eyebrow">About Manoj Teja</p>
            <img src="/assets/headshot.jpg" alt="Portrait of Manoj Teja Yadlapati" style="width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: center top; margin: 14px 0;" />
            <p>Insurance professional with a focus on liability, wordings, and cross-border risk across complex commercial environments.</p>
            <a class="button button--ghost" style="margin-top: 16px;" href="/#about">Learn more</a>
          </div>
          <div class="side-card">
            <p class="eyebrow">Areas of interest</p>
            <p>Large multinational corporate accounts, liability lines, professional indemnity, insurance wordings, specialty lines, property insurance, and geopolitical risk.</p>
          </div>
        </aside>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
