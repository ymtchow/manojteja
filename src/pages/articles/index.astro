---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const ARTICLES_PER_PAGE = 6;

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const comingSoon = [
  {
    title: 'Letters of Credit – Bridges of Global Trust',
    description: 'Understanding the legal architecture behind trade finance.',
    category: 'Insurance Wordings',
    image: '/assets/article-marine-card.webp',
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Articles | The Cross-Border Risk Review</title>
    <meta name="description" content="High-level articles on insurance, liability, wordings, specialty lines and cross-border risk from Dubai." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Articles | The Cross-Border Risk Review" />
    <meta property="og:description" content="High-level articles on insurance, liability, wordings, specialty lines and cross-border risk." />
    <meta property="og:image" content="/assets/article-page-banner-19-may-2025.png" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </head>
  <body class="insights-page">
    <SiteHeader />
    <main class="insights-wrap">
      <div class="insights-header">
        <div>
          <p class="eyebrow">All articles</p>
          <h1>High-level perspectives for insurance professionals.</h1>
        </div>
        <a class="text-link" href="/">Back home →</a>
      </div>
      <div class="article-tools" aria-label="Article search and pagination controls">
        <form class="article-search" data-article-search>
          <label class="sr-only" for="article-search-input">Search articles</label>
          <input id="article-search-input" type="search" placeholder="Search articles by title, theme, or category" autocomplete="off" />
          <button class="button button--dark" type="submit">Search</button>
        </form>
        <p class="article-count" data-article-count></p>
      </div>
      <div class="two-column">
        <section class="insight-list" aria-label="Article list" data-article-list data-page-size={ARTICLES_PER_PAGE}>
          {articles.map((article) => (
            <div
              class="article-list__item"
              data-article-item
              data-search={`${article.data.title ?? ''} ${article.data.description ?? ''} ${article.data.category ?? ''}`.toLowerCase()}
            >
              <ArticleCard article={article} variant="row" />
            </div>
          ))}
          {comingSoon.map((item) => (
            <div
              class="article-list__item"
              data-article-item
              data-search={`${item.title ?? ''} ${item.description ?? ''} ${item.category ?? ''} coming soon in preparation`.toLowerCase()}
            >
              <ArticleCard item={item} variant="row" comingSoon />
            </div>
          ))}
        </section>
        <aside>
          <div class="side-card side-card--profile">
            <div class="side-card__section">
              <p class="eyebrow">About Manoj Teja</p>
              <img src="/assets/headshot.jpg" alt="Portrait of Manoj Teja Yadlapati" />
              <p>Insurance professional with a focus on liability, wordings, and cross-border risk across complex commercial environments.</p>
              <a class="button button--ghost" href="/#about">Learn more</a>
            </div>
            <div class="side-card__section side-card__section--bordered">
              <p class="eyebrow">Areas of interest</p>
              <p>Large multinational corporate accounts, liability lines, professional indemnity, insurance wordings, specialty lines, property insurance, and geopolitical risk.</p>
            </div>
          </div>
        </aside>
      </div>
      <p class="no-results" data-no-results hidden>No matching articles found. Try a broader term such as insurance, liability, wordings, or risk.</p>
      <nav class="article-pagination" data-pagination hidden aria-label="Article pagination">
        <button class="button button--ghost" type="button" data-page-prev>Previous</button>
        <div class="article-pagination__numbers" data-page-numbers></div>
        <button class="button button--ghost" type="button" data-page-next>Next</button>
      </nav>
    </main>
    <SiteFooter />
    <style is:global>
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .article-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 24px;
      }

      .article-search {
        display: flex;
        width: min(680px, 100%);
        gap: 10px;
      }

      .article-search input {
        width: 100%;
        min-height: 48px;
        padding: 0 16px;
        border: 1px solid rgba(7, 18, 29, 0.16);
        border-radius: 4px;
        background: #fff;
        color: var(--paper-ink);
        font-size: 14px;
      }

      .article-count {
        color: var(--paper-muted);
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
      }

      .article-list__item[hidden],
      .no-results[hidden],
      .article-pagination[hidden] {
        display: none !important;
      }

      .side-card--profile {
        padding: 28px;
      }

      .side-card--profile img {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        object-position: center top;
        margin: 16px 0 18px;
      }

      .side-card--profile p:not(.eyebrow) {
        color: var(--paper-ink);
        font-size: 15px;
        line-height: 1.7;
      }

      .side-card--profile .button {
        margin-top: 18px;
      }

      .side-card__section--bordered {
        margin-top: 28px;
        padding-top: 24px;
        border-top: 1px solid rgba(7, 18, 29, 0.12);
      }

      .side-card__section--bordered p:not(.eyebrow) {
        margin-top: 10px;
      }

      .no-results {
        margin-top: 24px;
        padding: 20px 24px;
        border: 1px solid rgba(7, 18, 29, 0.12);
        border-radius: 4px;
        background: #fff;
        color: var(--paper-muted);
      }

      .article-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-top: 32px;
      }

      .article-pagination__numbers {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
      }

      .article-pagination__numbers button {
        width: 42px;
        min-height: 42px;
        border: 1px solid rgba(7, 18, 29, 0.16);
        border-radius: 50%;
        background: #fff;
        color: var(--paper-ink);
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
      }

      .article-pagination__numbers button.is-active {
        background: var(--navy-900);
        color: var(--ink);
        border-color: rgba(239, 201, 121, 0.28);
      }

      .article-pagination .button:disabled,
      .article-pagination__numbers button:disabled {
        opacity: 0.45;
        cursor: not-allowed;
      }

      @media (max-width: 980px) {
        .article-tools {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 640px) {
        .article-search,
        .article-pagination {
          align-items: stretch;
          flex-direction: column;
        }

        .article-search .button,
        .article-pagination .button {
          width: 100%;
        }
      }
    </style>
    <script is:inline>
      (() => {
        const list = document.querySelector('[data-article-list]');
        if (!list) return;

        const pageSize = Number(list.dataset.pageSize || 6);
        const items = Array.from(list.querySelectorAll('[data-article-item]'));
        const form = document.querySelector('[data-article-search]');
        const input = document.querySelector('#article-search-input');
        const count = document.querySelector('[data-article-count]');
        const pagination = document.querySelector('[data-pagination]');
        const prev = document.querySelector('[data-page-prev]');
        const next = document.querySelector('[data-page-next]');
        const pageNumbers = document.querySelector('[data-page-numbers]');
        const noResults = document.querySelector('[data-no-results]');
        const pageAnchor = document.querySelector('.insights-header');
        let currentPage = 1;
        let filteredItems = items;

        const getSearchText = (item) => item.dataset.search || item.textContent.toLowerCase();

        const scrollToList = () => {
          pageAnchor?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        };

        const setPage = (page, shouldScroll = true) => {
          currentPage = page;
          render();
          if (shouldScroll) scrollToList();
        };

        const renderPageButtons = (totalPages) => {
          if (!pageNumbers) return;
          pageNumbers.innerHTML = '';

          for (let page = 1; page <= totalPages; page += 1) {
            const button = document.createElement('button');
            button.type = 'button';
            button.textContent = String(page);
            button.setAttribute('aria-label', `Go to page ${page}`);
            if (page === currentPage) {
              button.classList.add('is-active');
              button.setAttribute('aria-current', 'page');
            }
            button.addEventListener('click', () => setPage(page));
            pageNumbers.appendChild(button);
          }
        };

        function render() {
          const total = filteredItems.length;
          const totalPages = Math.max(1, Math.ceil(total / pageSize));
          currentPage = Math.min(currentPage, totalPages);

          const start = (currentPage - 1) * pageSize;
          const end = start + pageSize;
          const visibleItems = filteredItems.slice(start, end);

          items.forEach((item) => {
            item.hidden = true;
          });
          visibleItems.forEach((item) => {
            item.hidden = false;
          });

          if (count) {
            count.textContent = total === 1 ? '1 item shown' : `${total} items shown`;
          }

          if (noResults) {
            noResults.hidden = total !== 0;
          }

          if (pagination) {
            pagination.hidden = total <= pageSize;
          }

          if (prev) {
            prev.disabled = currentPage === 1;
          }

          if (next) {
            next.disabled = currentPage >= totalPages;
          }

          renderPageButtons(totalPages);
        }

        const applySearch = () => {
          const query = (input?.value || '').trim().toLowerCase();
          filteredItems = items.filter((item) => !query || getSearchText(item).includes(query));
          currentPage = 1;
          render();
        };

        form?.addEventListener('submit', (event) => {
          event.preventDefault();
          applySearch();
        });

        input?.addEventListener('input', applySearch);

        prev?.addEventListener('click', () => {
          if (currentPage > 1) setPage(currentPage - 1);
        });

        next?.addEventListener('click', () => {
          const totalPages = Math.max(1, Math.ceil(filteredItems.length / pageSize));
          if (currentPage < totalPages) setPage(currentPage + 1);
        });

        render();
      })();
    </script>
  </body>
</html>
