---
import '../../styles/global.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const formattedDate = article.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const readTime = `${Math.max(4, Math.ceil((article.body || '').split(/\s+/).filter(Boolean).length / 220))} min read`;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{article.data.title} | Manoj Teja Y</title>
    {article.data.description && <meta name="description" content={article.data.description} />}
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={`${article.data.title} | Manoj Teja Y`} />
    {article.data.description && <meta property="og:description" content={article.data.description} />}
    {article.data.featuredImage && <meta property="og:image" content={article.data.featuredImage} />}
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <style>
      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 78% 10%, rgba(232, 184, 136, .16), transparent 28%),
          linear-gradient(180deg, rgba(11, 19, 34, .86), rgba(11, 19, 34, .98));
      }

      .article-shell {
        max-width: 1040px;
        margin: 0 auto;
        padding: 34px 24px 82px;
      }

      .article-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        margin-bottom: 28px;
      }

      .article-brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: var(--ink);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      .article-brand img {
        width: 52px;
        height: 36px;
        object-fit: contain;
      }

      .article-back {
        color: var(--amber-bright);
        border: 1px solid rgba(232, 184, 136, .32);
        border-radius: 999px;
        padding: 10px 15px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .11em;
        text-transform: uppercase;
      }

      .article-card {
        border: 1px solid rgba(232, 184, 136, .22);
        border-radius: 34px;
        background: linear-gradient(180deg, rgba(20, 33, 59, .78), rgba(11, 19, 34, .92));
        box-shadow: 0 30px 90px rgba(0, 0, 0, .36);
        overflow: hidden;
      }

      .article-hero {
        padding: 42px 42px 30px;
        background:
          linear-gradient(100deg, rgba(11, 19, 34, .94), rgba(11, 19, 34, .70)),
          var(--article-hero-image, none) center / cover;
      }

      .article-kicker {
        margin: 0 0 14px;
        color: var(--amber-bright);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
      }

      .article-hero h1 {
        max-width: 820px;
        margin: 0;
        font-family: var(--serif);
        font-size: clamp(38px, 5vw, 66px);
        line-height: 1.02;
        letter-spacing: -.035em;
      }

      .article-description {
        max-width: 780px;
        margin: 22px 0 0;
        color: var(--ink-soft);
        font-size: 17px;
        line-height: 1.75;
      }

      .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
      }

      .article-meta span {
        border: 1px solid rgba(237, 230, 214, .14);
        border-radius: 999px;
        padding: 8px 12px;
        color: var(--muted);
        font-size: 12px;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .audio-panel {
        margin: 28px 42px 0;
        border: 1px solid rgba(232, 184, 136, .24);
        border-radius: 24px;
        padding: 20px;
        background: rgba(11, 19, 34, .72);
      }

      .audio-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
      }

      .audio-panel-title {
        margin: 0;
        color: var(--ink);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      .audio-panel-note {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
      }

      .audio-panel audio {
        width: 100%;
        display: block;
      }

      .article-body-wrap {
        padding: 38px 42px 46px;
      }

      .article-content {
        color: var(--ink-soft);
        font-size: 17px;
        line-height: 1.82;
      }

      .article-content h1,
      .article-content h2,
      .article-content h3 {
        color: var(--ink);
        font-family: var(--serif);
        line-height: 1.15;
        letter-spacing: -.018em;
      }

      .article-content h1 { font-size: 32px; margin-top: 0; }
      .article-content h2 { font-size: 28px; margin-top: 34px; }
      .article-content h3 { font-size: 24px; margin-top: 32px; }

      .article-content p,
      .article-content ul,
      .article-content ol,
      .article-content table {
        margin-top: 18px;
      }

      .article-content img {
        width: 100%;
        border-radius: 24px;
        border: 1px solid rgba(232, 184, 136, .20);
        margin: 24px 0;
        box-shadow: 0 18px 46px rgba(0,0,0,.24);
      }

      .article-content table {
        width: 100%;
        border-collapse: collapse;
        overflow: hidden;
        border-radius: 18px;
        display: block;
        overflow-x: auto;
      }

      .article-content th,
      .article-content td {
        border: 1px solid rgba(237, 230, 214, .14);
        padding: 12px;
        vertical-align: top;
      }

      .article-content th {
        color: var(--ink);
        background: rgba(232, 184, 136, .10);
      }

      .resource-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 34px;
        padding-top: 26px;
        border-top: 1px solid rgba(237, 230, 214, .12);
      }

      .resource-links a,
      .article-footer-link {
        color: var(--amber-bright);
        font-weight: 800;
      }

      .article-footer {
        margin-top: 28px;
        display: flex;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
      }

      @media (max-width: 760px) {
        .article-shell { padding: 24px 16px 64px; }
        .article-topbar { align-items: flex-start; flex-direction: column; }
        .article-hero { padding: 32px 24px 26px; }
        .audio-panel { margin: 22px 24px 0; }
        .audio-panel-header { align-items: flex-start; flex-direction: column; }
        .article-body-wrap { padding: 30px 24px 38px; }
        .article-content { font-size: 16px; line-height: 1.78; }
      }
    </style>
  </head>
  <body>
    <main class="article-shell">
      <nav class="article-topbar">
        <a class="article-brand" href="/"><img src="/assets/ymt-logo-mark.png" alt="YMT logo" /><span>Manoj Teja Y</span></a>
        <a class="article-back" href="/articles/">Back to insights</a>
      </nav>

      <article class="article-card">
        <header class="article-hero" style={article.data.featuredImage ? `--article-hero-image: url('${article.data.featuredImage}')` : undefined}>
          <p class="article-kicker">{article.data.category}</p>
          <h1>{article.data.title}</h1>
          {article.data.description && <p class="article-description">{article.data.description}</p>}
          <div class="article-meta">
            <span>{formattedDate}</span>
            <span>{readTime}</span>
            <span>By Manoj Teja Y</span>
          </div>
        </header>

        {article.data.audio && (
          <section class="audio-panel" aria-label="Audio perspective">
            <div class="audio-panel-header">
              <div>
                <p class="audio-panel-title">Listen to Audio Perspective</p>
                <p class="audio-panel-note">Listen on this page while reading. Playback controls are handled by your browser.</p>
              </div>
            </div>
            <audio controls preload="metadata" src={article.data.audio}>
              <a href={article.data.audio}>Listen to the audio perspective</a>
            </audio>
          </section>
        )}

        <div class="article-body-wrap">
          <div class="article-content">
            <Content />
          </div>

          <div class="resource-links">
            {article.data.pdf && <a href={article.data.pdf} target="_blank" rel="noopener noreferrer">Open PDF brief ↗</a>}
            {article.data.audio && <a href={article.data.audio} target="_blank" rel="noopener noreferrer">Open audio directly ↗</a>}
          </div>

          <footer class="article-footer">
            <a class="article-footer-link" href="/articles/">← Back to insights</a>
            <a class="article-footer-link" href="/disclaimer/">Disclaimer</a>
          </footer>
        </div>
      </article>
    </main>
  </body>
</html>
