---
import '../../styles/global.css';
import '../../styles/article-seo.css';
import '../../styles/mobile-article-fix.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const formatDate = (date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const wordCount = (article.body || '').split(/\s+/).filter(Boolean).length;
const readTime = `${Math.max(6, Math.ceil(wordCount / 210))} min read`;
const heroImage = article.data.featuredImage ?? '/assets/article-page-banner-19-may-2025.png';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.manojteja.com';
const articleUrl = new URL(`/articles/${article.id}/`, `${siteUrl}/`).toString();
const absoluteUrl = (path) => path?.startsWith('http') ? path : new URL(path ?? '/', `${siteUrl}/`).toString();
const heroImageUrl = absoluteUrl(heroImage);
const seoDescription = article.data.description ?? 'Independent insurance perspective from The Cross-Border Risk Review.';
const pageTitle = `${article.data.title} | The Cross-Border Risk Review`;
const publishedIso = article.data.date.toISOString();
const encodedArticleUrl = encodeURIComponent(articleUrl);
const encodedShareText = encodeURIComponent(`${article.data.title} | The Cross-Border Risk Review`);
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedArticleUrl}`;
const xShareUrl = `https://twitter.com/intent/tweet?url=${encodedArticleUrl}&text=${encodedShareText}`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedArticleUrl}`;
const whatsappShareUrl = `https://wa.me/?text=${encodeURIComponent(`${article.data.title} ${articleUrl}`)}`;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  headline: article.data.title,
  description: seoDescription,
  image: [heroImageUrl],
  datePublished: publishedIso,
  dateModified: publishedIso,
  author: {
    '@type': 'Person',
    name: 'Manoj Teja Yadlapati',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'The Cross-Border Risk Review',
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl('/assets/ymt-logo-mark.png'),
    },
  },
  articleSection: article.data.category,
  wordCount,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Articles',
      item: new URL('/articles/', `${siteUrl}/`).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.data.title,
      item: articleUrl,
    },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={articleUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="The Cross-Border Risk Review" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={articleUrl} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="article:published_time" content={publishedIso} />
    <meta property="article:modified_time" content={publishedIso} />
    <meta property="article:author" content="Manoj Teja Yadlapati" />
    <meta property="article:section" content={article.data.category} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={heroImageUrl} />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <style>
      .article-hero {
        grid-template-columns: 1fr;
        min-height: 430px;
        padding: clamp(34px, 6vw, 62px);
        isolation: isolate;
        background:
          linear-gradient(90deg, rgba(2, 11, 19, 0.92) 0%, rgba(2, 11, 19, 0.74) 46%, rgba(2, 11, 19, 0.28) 100%),
          var(--article-hero-image) center / cover no-repeat;
      }

      .article-hero > div {
        max-width: 680px;
      }

      .desktop-share {
        display: block;
        margin-top: 34px;
      }

      .desktop-share h2 {
        margin: 0;
      }

      .desktop-share__icons {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 14px;
      }

      .desktop-share__icon,
      .desktop-share__copy {
        display: inline-grid;
        place-items: center;
        width: 39px;
        height: 39px;
        border: 1px solid rgba(190, 153, 91, 0.5);
        border-radius: 50%;
        background: #102031;
        color: #d8b36a;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease, background 160ms ease;
      }

      .desktop-share__icon:hover,
      .desktop-share__copy:hover {
        background: #0b1725;
        border-color: rgba(216, 179, 106, 0.9);
        box-shadow: 0 10px 24px rgba(16, 32, 49, 0.12);
        transform: translateY(-1px);
      }

      .desktop-share__icon svg,
      .desktop-share__copy svg {
        width: 17px;
        height: 17px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.75;
      }

      .article-share {
        margin: clamp(34px, 5vw, 54px) 0 0;
        padding: clamp(22px, 4vw, 30px);
        border: 1px solid rgba(190, 153, 91, 0.28);
        border-radius: 26px;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(247, 240, 228, 0.7)),
          radial-gradient(circle at top left, rgba(216, 179, 106, 0.16), transparent 34%);
        box-shadow: 0 18px 44px rgba(16, 32, 49, 0.08);
      }

      .article-share h2 {
        margin: 0;
        color: #102031;
        font-family: Newsreader, Georgia, serif;
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .article-share p {
        margin: 8px 0 0;
        color: rgba(16, 32, 49, 0.68);
        font-size: 14px;
        line-height: 1.6;
      }

      .share-links {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 10px;
        margin-top: 18px;
      }

      .share-link,
      .copy-share-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 46px;
        border: 1px solid rgba(190, 153, 91, 0.34);
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(247, 240, 228, 0.66));
        color: #102031;
        cursor: pointer;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.03em;
        padding: 9px 12px 9px 9px;
        text-align: center;
        text-decoration: none;
        transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease, background 160ms ease;
      }

      .share-link:hover,
      .copy-share-button:hover {
        background: #ffffff;
        border-color: rgba(190, 153, 91, 0.76);
        box-shadow: 0 10px 24px rgba(16, 32, 49, 0.08);
        transform: translateY(-1px);
      }

      .share-mark {
        display: inline-grid;
        place-items: center;
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        border: 1px solid rgba(190, 153, 91, 0.55);
        border-radius: 50%;
        background: #102031;
        color: #d8b36a;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.01em;
        line-height: 1;
      }

      .share-mark svg {
        width: 15px;
        height: 15px;
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.75;
      }

      .share-label {
        line-height: 1;
      }

      .copy-share-button:focus-visible,
      .share-link:focus-visible,
      .desktop-share__icon:focus-visible,
      .desktop-share__copy:focus-visible {
        outline: 2px solid rgba(190, 153, 91, 0.9);
        outline-offset: 3px;
      }

      @media (max-width: 980px) {
        .share-links {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 760px) {
        html,
        body {
          max-width: 100%;
          overflow-x: hidden;
        }

        .article-layout {
          display: block;
          width: 100%;
          max-width: 100%;
          padding: 28px 20px 56px;
          overflow: hidden;
        }

        .article-aside {
          position: static;
          margin-bottom: 24px;
        }

        .article-aside nav,
        .desktop-share {
          display: none;
        }

        .share-links {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .article-main,
        .article-content,
        .article-hero,
        .audio-card {
          width: 100%;
          max-width: 100%;
          min-width: 0;
        }

        .article-hero {
          min-height: 360px;
          margin: 22px 0 0;
          padding: 28px 22px;
        }

        .article-hero h1 {
          font-size: clamp(34px, 10vw, 44px);
          line-height: 1.05;
        }

        .article-hero p {
          font-size: 16px;
          line-height: 1.55;
        }

        .article-content table {
          display: block;
          max-width: 100%;
          overflow-x: auto;
        }

        .featured-publication__actions {
          flex-direction: column;
          align-items: stretch;
        }

        .featured-publication__actions .button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body class="article-shell">
    <SiteHeader />
    <main class="article-layout">
      <aside class="article-aside" aria-label="Article navigation">
        <a class="back-link" href="/articles/">← Back to articles</a>
        {headings?.length > 0 && (
          <nav style="margin-top: 34px;">
            <h2>On this page</h2>
            {headings.filter((heading) => heading.depth <= 2).slice(0, 7).map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        )}
        <section class="desktop-share" aria-label="Share this article on desktop">
          <h2>Share</h2>
          <div class="desktop-share__icons" aria-label="Desktop social sharing links">
            <a class="desktop-share__icon" href={linkedInShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">in</a>
            <a class="desktop-share__icon" href={xShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>
            <a class="desktop-share__icon" href={facebookShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">f</a>
            <a class="desktop-share__icon" href={whatsappShareUrl} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <path d="M7.2 19.1 4.5 20l.9-2.6a8.1 8.1 0 1 1 1.8 1.7Z" />
                <path d="M9.2 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.3 0 .5-.1.7l-.4.5c.8 1.4 1.8 2.3 3.2 3.1l.6-.6c.2-.2.4-.2.7-.1l1.6.7c.3.1.4.3.4.6v.5c0 .3-.2.6-.5.8-.5.3-1.2.5-1.9.4-3.5-.5-6.4-3.3-7-6.8-.1-.7.1-1.4.4-1.9Z" />
              </svg>
            </a>
            <button class="desktop-share__copy" type="button" data-copy-share-link data-share-url={articleUrl} aria-label="Copy article link">
              <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                <rect x="8" y="8" width="10" height="10" rx="2" />
                <path d="M6 14H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1" />
              </svg>
              <span class="share-label" hidden>Copy link</span>
            </button>
          </div>
        </section>
      </aside>

      <article class="article-main">
        <section class="article-hero" style={`--article-hero-image: url('${heroImage}')`}>
          <div>
            <p class="eyebrow">{article.data.category}</p>
            <h1>{article.data.title}</h1>
            {article.data.description && <p>{article.data.description}</p>}
            <div class="article-hero__meta">
              <span>{readTime}</span>
              <span>{formatDate(article.data.date)}</span>
              <span>By Manoj Teja Yadlapati</span>
            </div>
          </div>
        </section>

        {article.data.audio && (
          <section class="audio-card" id="audio" aria-label="Audio perspective">
            <p class="eyebrow">Listen to audio perspective</p>
            <audio controls preload="metadata" src={article.data.audio}></audio>
          </section>
        )}

        <div class="article-content">
          <Content />
        </div>

        <section class="article-share" aria-label="Share this article">
          <h2>Share this article</h2>
          <p>Forward this perspective to your professional network or save the link for later reference.</p>
          <div class="share-links" aria-label="Social sharing links">
            <a class="share-link" href={linkedInShareUrl} target="_blank" rel="noopener noreferrer"><span class="share-mark" aria-hidden="true">in</span><span class="share-label">LinkedIn</span></a>
            <a class="share-link" href={xShareUrl} target="_blank" rel="noopener noreferrer"><span class="share-mark" aria-hidden="true">X</span><span class="share-label">X</span></a>
            <a class="share-link" href={facebookShareUrl} target="_blank" rel="noopener noreferrer"><span class="share-mark" aria-hidden="true">f</span><span class="share-label">Facebook</span></a>
            <a class="share-link" href={whatsappShareUrl} target="_blank" rel="noopener noreferrer">
              <span class="share-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                  <path d="M7.2 19.1 4.5 20l.9-2.6a8.1 8.1 0 1 1 1.8 1.7Z" />
                  <path d="M9.2 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.3 0 .5-.1.7l-.4.5c.8 1.4 1.8 2.3 3.2 3.1l.6-.6c.2-.2.4-.2.7-.1l1.6.7c.3.1.4.3.4.6v.5c0 .3-.2.6-.5.8-.5.3-1.2.5-1.9.4-3.5-.5-6.4-3.3-7-6.8-.1-.7.1-1.4.4-1.9Z" />
                </svg>
              </span>
              <span class="share-label">WhatsApp</span>
            </a>
            <button class="copy-share-button" type="button" data-copy-share-link data-share-url={articleUrl}><span class="share-mark" aria-hidden="true">⧉</span><span class="share-label">Copy link</span></button>
          </div>
        </section>

        <div class="featured-publication__actions" style="margin: 32px 0 0;">
          {article.data.pdf && <a class="button button--dark" href={article.data.pdf} target="_blank" rel="noopener noreferrer">Open PDF brief ↗</a>}
          <a class="button button--ghost" href="/articles/">Back to all articles</a>
        </div>
      </article>
    </main>
    <SiteFooter />
    <script is:inline>
      document.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-copy-share-link]');
        if (!button) return;

        const shareUrl = button.getAttribute('data-share-url');
        const label = button.querySelector('.share-label');
        const originalText = label?.textContent ?? 'Copy link';

        try {
          await navigator.clipboard.writeText(shareUrl);
        } catch (error) {
          const textArea = document.createElement('textarea');
          textArea.value = shareUrl;
          textArea.setAttribute('readonly', '');
          textArea.style.position = 'absolute';
          textArea.style.left = '-9999px';
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
        }

        if (label) label.textContent = 'Copied';
        window.setTimeout(() => {
          if (label) label.textContent = originalText;
        }, 1800);
      });
    </script>
  </body>
</html>