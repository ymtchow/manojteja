---
import '../../styles/global.css';
import '../../styles/article-seo.css';
import '../../styles/mobile-article-fix.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((article) => !article.data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
const formatDate = (date) => date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const wordCount = (article.body || '').split(/\s+/).filter(Boolean).length;
const readTime = `${Math.max(6, Math.ceil(wordCount / 210))} min read`;
const heroImage = article.data.featuredImage ?? '/assets/article-page-banner-19-may-2025.png';
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.manojteja.com';
const articleUrl = new URL(`/articles/${article.id}/`, `${siteUrl}/`).toString();
const absoluteUrl = (path) => path?.startsWith('http') ? path : new URL(path ?? '/', `${siteUrl}/`).toString();
const heroImageUrl = absoluteUrl(heroImage);
const seoDescription = article.data.description ?? 'Independent insurance perspective from The Cross-Border Risk Review.';
const pageTitle = `${article.data.title} | The Cross-Border Risk Review`;
const publishedIso = article.data.date.toISOString();
const encodedArticleUrl = encodeURIComponent(articleUrl);
const encodedShareText = encodeURIComponent(`${article.data.title} | The Cross-Border Risk Review`);
const linkedInShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedArticleUrl}`;
const xShareUrl = `https://twitter.com/intent/tweet?url=${encodedArticleUrl}&text=${encodedShareText}`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedArticleUrl}`;
const whatsappShareUrl = `https://wa.me/?text=${encodeURIComponent(`${article.data.title} ${articleUrl}`)}`;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  headline: article.data.title,
  description: seoDescription,
  image: [heroImageUrl],
  datePublished: publishedIso,
  dateModified: publishedIso,
  author: { '@type': 'Person', name: 'Manoj Teja Yadlapati', url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: 'The Cross-Border Risk Review',
    logo: { '@type': 'ImageObject', url: absoluteUrl('/assets/ymt-logo-mark.png') },
  },
  articleSection: article.data.category,
  wordCount,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL('/articles/', `${siteUrl}/`).toString() },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: articleUrl },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={articleUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="The Cross-Border Risk Review" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={articleUrl} />
    <meta property="og:image" content={heroImageUrl} />
    <meta property="article:published_time" content={publishedIso} />
    <meta property="article:modified_time" content={publishedIso} />
    <meta property="article:author" content="Manoj Teja Yadlapati" />
    <meta property="article:section" content={article.data.category} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={heroImageUrl} />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
    <style>
      .article-hero {
        grid-template-columns: 1fr;
        min-height: 430px;
        padding: clamp(34px, 6vw, 62px);
        isolation: isolate;
        background:
          linear-gradient(90deg, rgba(2, 11, 19, 0.92) 0%, rgba(2, 11, 19, 0.74) 46%, rgba(2, 11, 19, 0.28) 100%),
          var(--article-hero-image) center / cover no-repeat;
      }

      .article-hero > div { max-width: 680px; }

      .desktop-share { display: block; margin-top: 34px; }
      .desktop-share h2 { margin: 0 0 12px; }
      .desktop-share__icons { display: grid; gap: 10px; margin-top: 12px; }

      .desktop-share__icon,
      .desktop-share__copy {
        -webkit-appearance: none;
        appearance: none;
        box-sizing: border-box;
        display: flex !important;
        align-items: center;
        justify-content: center;
        width: 100% !important;
        min-height: 42px;
        border: 1px solid rgba(190, 153, 91, 0.52);
        border-radius: 999px;
        background: #102031;
        color: #d8b36a;
        cursor: pointer;
        font: inherit;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        line-height: 1;
        padding: 0 14px;
        text-decoration: none;
        text-transform: uppercase;
      }

      .desktop-share__icon:hover,
      .desktop-share__copy:hover,
      .share-link:hover,
      .copy-share-button:hover {
        background: #0b1725;
        border-color: rgba(216, 179, 106, 0.95);
        color: #efc979;
      }

      .article-share {
        display: block;
        margin: clamp(24px, 4vw, 36px) 0 0;
        padding: clamp(20px, 4vw, 28px);
        border: 1px solid rgba(190, 153, 91, 0.28);
        border-radius: 22px;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(247, 240, 228, 0.74)),
          radial-gradient(circle at top left, rgba(216, 179, 106, 0.16), transparent 34%);
        box-shadow: 0 18px 44px rgba(16, 32, 49, 0.08);
      }

      .article-share--top { margin-bottom: 26px; }
      .article-share h2 {
        margin: 0;
        color: #102031;
        font-family: Newsreader, Georgia, serif;
        font-size: clamp(23px, 3vw, 30px);
        font-weight: 600;
      }
      .article-share p { margin: 8px 0 0; color: rgba(16, 32, 49, 0.68); font-size: 14px; line-height: 1.6; }
      .share-links { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; margin-top: 18px; }

      .share-link,
      .copy-share-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 46px;
        border: 1px solid rgba(190, 153, 91, 0.42);
        border-radius: 999px;
        background: #102031;
        color: #d8b36a;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.06em;
        padding: 9px 14px;
        text-align: center;
        text-decoration: none;
        text-transform: uppercase;
      }

      .copy-share-button:focus-visible,
      .share-link:focus-visible,
      .desktop-share__icon:focus-visible,
      .desktop-share__copy:focus-visible { outline: 2px solid rgba(190, 153, 91, 0.9); outline-offset: 3px; }

      @media (max-width: 980px) { .share-links { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

      @media (max-width: 760px) {
        html, body { max-width: 100%; overflow-x: hidden; }
        .article-layout { display: block; width: 100%; max-width: 100%; padding: 28px 20px 56px; overflow: hidden; }
        .article-aside { position: static; margin-bottom: 24px; }
        .article-aside nav, .desktop-share { display: none; }
        .article-share--top { display: none; }
        .share-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .article-main, .article-content, .article-hero, .audio-card { width: 100%; max-width: 100%; min-width: 0; }
        .article-hero { min-height: 360px; margin: 22px 0 0; padding: 28px 22px; }
        .article-hero h1 { font-size: clamp(34px, 10vw, 44px); line-height: 1.05; }
        .article-hero p { font-size: 16px; line-height: 1.55; }
        .featured-publication__actions { flex-direction: column; align-items: stretch; }
        .featured-publication__actions .button { width: 100%; }
      }
    </style>
  </head>
  <body class="article-shell">
    <SiteHeader />
    <main class="article-layout">
      <aside class="article-aside" aria-label="Article navigation">
        <a class="back-link" href="/articles/">← Back to articles</a>
        {headings?.length > 0 && (
          <nav style="margin-top: 34px;">
            <h2>On this page</h2>
            {headings.filter((heading) => heading.depth <= 2).slice(0, 7).map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        )}
        <section class="desktop-share" aria-label="Share this article on desktop">
          <h2>Share</h2>
          <div class="desktop-share__icons">
            <button class="desktop-share__icon" type="button" data-share-open={linkedInShareUrl}>LinkedIn</button>
            <button class="desktop-share__icon" type="button" data-share-open={xShareUrl}>X</button>
            <button class="desktop-share__icon" type="button" data-share-open={facebookShareUrl}>Facebook</button>
            <button class="desktop-share__icon" type="button" data-share-open={whatsappShareUrl}>WhatsApp</button>
            <button class="desktop-share__copy" type="button" data-copy-share-link data-share-url={articleUrl}>Copy link</button>
          </div>
        </section>
      </aside>

      <article class="article-main">
        <section class="article-hero" style={`--article-hero-image: url('${heroImage}')`}>
          <div>
            <p class="eyebrow">{article.data.category}</p>
            <h1>{article.data.title}</h1>
            {article.data.description && <p>{article.data.description}</p>}
            <div class="article-hero__meta">
              <span>{readTime}</span>
              <span>{formatDate(article.data.date)}</span>
              <span>By Manoj Teja Yadlapati</span>
            </div>
          </div>
        </section>

        <section class="article-share article-share--top" aria-label="Share this article">
          <h2>Share this article</h2>
          <p>Use the buttons below to share or copy this article link.</p>
          <div class="share-links">
            <button class="share-link" type="button" data-share-open={linkedInShareUrl}>LinkedIn</button>
            <button class="share-link" type="button" data-share-open={xShareUrl}>X</button>
            <button class="share-link" type="button" data-share-open={facebookShareUrl}>Facebook</button>
            <button class="share-link" type="button" data-share-open={whatsappShareUrl}>WhatsApp</button>
            <button class="copy-share-button" type="button" data-copy-share-link data-share-url={articleUrl}>Copy link</button>
          </div>
        </section>

        {article.data.audio && (
          <section class="audio-card" id="audio" aria-label="Audio perspective">
            <p class="eyebrow">Listen to audio perspective</p>
            <audio controls preload="metadata" src={article.data.audio}></audio>
          </section>
        )}

        <div class="article-content"><Content /></div>

        <section class="article-share" aria-label="Share this article again">
          <h2>Share this article</h2>
          <p>Forward this perspective to your professional network or save the link for later reference.</p>
          <div class="share-links">
            <button class="share-link" type="button" data-share-open={linkedInShareUrl}>LinkedIn</button>
            <button class="share-link" type="button" data-share-open={xShareUrl}>X</button>
            <button class="share-link" type="button" data-share-open={facebookShareUrl}>Facebook</button>
            <button class="share-link" type="button" data-share-open={whatsappShareUrl}>WhatsApp</button>
            <button class="copy-share-button" type="button" data-copy-share-link data-share-url={articleUrl}>Copy link</button>
          </div>
        </section>

        <div class="featured-publication__actions" style="margin: 32px 0 0;">
          {article.data.pdf && <a class="button button--dark" href={article.data.pdf} target="_blank" rel="noopener noreferrer">Open PDF brief ↗</a>}
          <a class="button button--ghost" href="/articles/">Back to all articles</a>
        </div>
      </article>
    </main>
    <SiteFooter />
    <script is:inline>
      document.addEventListener('click', async (event) => {
        const openButton = event.target.closest('[data-share-open]');
        if (openButton) {
          const url = openButton.getAttribute('data-share-open');
          window.open(url, '_blank', 'noopener,noreferrer,width=720,height=640');
          return;
        }

        const copyButton = event.target.closest('[data-copy-share-link]');
        if (!copyButton) return;
        const shareUrl = copyButton.getAttribute('data-share-url');
        const originalText = copyButton.textContent;

        try {
          await navigator.clipboard.writeText(shareUrl);
        } catch (error) {
          const textArea = document.createElement('textarea');
          textArea.value = shareUrl;
          textArea.setAttribute('readonly', '');
          textArea.style.position = 'absolute';
          textArea.style.left = '-9999px';
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
        }

        copyButton.textContent = 'Copied';
        window.setTimeout(() => { copyButton.textContent = originalText; }, 1800);
      });
    </script>
  </body>
</html>