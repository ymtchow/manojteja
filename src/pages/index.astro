---
import '../styles/global.css';
import '../styles/image-overrides.css';
import '../styles/about-refresh.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = articles.find((article) => article.id === 'whose-law-which-court') ?? articles[0];
const comingSoon = [
  {
    title: 'Marine Insurance â€“ Bridges of Global Trade',
    description: 'A practical look at maritime risk, cargo movement, ports, and the insurance structures behind global trade.',
    category: 'Marine Insurance',
    date: 'Coming soon',
    image: '/assets/article-marine-card.webp',
  },
  {
    title: 'Why Policy Wordings Determine Outcomes More Than Most Realize',
    description: 'The critical role of language in shaping coverage, liability and intent.',
    category: 'Insurance Wordings',
    date: 'Coming soon',
    image: '/assets/brand-executive-home-bg-v3.svg',
  },
];

const formatDate = (date) => date.toLocaleDateString('en-GB', { day: '02-digit', month: 'short', year: 'numeric' });
const readTime = (article) => `${Math.max(6, Math.ceil((article.body || '').split(/\s+/).filter(Boolean).length / 210))} min read`;

const areas = [
  ['â—", 'Large Multinational Corporate Accounts', 'Cross-border programmes, fronting considerations, and complex account servicing.'],
  ['â™¢', 'Liability Lines', 'Commercial liability, casualty exposure, defence strategy, and claims pathways.'],
  ['b”™', 'Professional Indemnity', 'PI disputes, claims-made pressure points, and advisory-risk wording issues.'],
  ['â–¤', 'Insurance Wordings', 'Policy language, exclusions, jurisdiction clauses, and coverage alignment.'],
  ['âœ¦", 'Specialty Lines', 'Cyber, financial lines, niche placements, and emerging risk transfer.'],
  ['b”¥%', 'Property Insurance', 'Property programme structure, catastrophe exposure, and business interruption themes.'],
  ['b”‹', 'Geopolitical Risk & Insurance', 'Trade disruption, sanctions context, political volatility, and territorial risk.'],
  ['â—†', 'Cross-Border Disputes', 'Forum, law, enforcement and insurance response across jurisdictions.'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manoj Teja Yadlapati | Cross-border Insurance Perspectives</title>
    <meta name="description" content="Independent perspectives on insurance wordings, complex claims, jurisdictional risk, and the commercial forces shaping global risk transfer." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Manoj Teja Yadlapati | Cross-border Insurance Perspectives" />
    <meta property="og:description" content="Insurance, liability, and cross-border risk perspectives from Dubai to global markets." />
    <meta property="og:image" content="/assets/site-hero-main.webp" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&amp;display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="hero">
        <div class="hero__inner">
          <div class="hero__copy">
            <p class="eyebrow">Cross-border insurance perspectives</p>
            <h1>Insurance, liability, and cross-border risk â€” from <em>Dubai to global markets.</em></h1>
            <div class="hero__line"></div>
            <p class="hero__lede">Independent perspectives on insurance wordings, complex claims, jurisdictional risk, and the commercial forces shaping global risk transfer.</p>
            <div class="hero__actions">
              <a class="button button--gold" href="/articles/">Explore latest perspectives â†’</a>
              <a class="button button--line" href="/podcasts/">Listen to podcast â†’</a>
            </div>
          </div>
        </div>
      </section>

      {featured && (
        <section class="section">
          <div class="container featured-publication">
            <div class="featured-publication__copy">
              <p class="eyebrow">Featured publication</p>
              <h2>{featured.data.title}</h2>
              {featured.data.description && <p>{featured.data.description}</p>}
              <p>A practical lens on law, forum, enforcement, and insurance response in cross-border commercial and insurance disputes.</p>
              <div class="featured-publication__actions">
                <a class="button button--dark" href={`/articles/${featured.id}/`}>Read article</a>
                {featured.data.audio && <a class="button button--ghost" href={`/articles/${featured.id}/#audio}>Listen to podcast â–¶</a>}
              </div>
            </div>
            <a class="feature-image" href={`/articles/${featured.id}/`} aria-label={`Read ${featured.data.title}`}>
              <img src={featured.data.featuredImage ?? '/assets/article-whose-law-card.webp'} alt="" />
            </a>
          </div>
        </section>
      )}

      <section class="section" id="areas">
        <div class="container">
          <div class="section__head">
            <div>
              <p class="eyebrow">Areas of interest</p>
              <h2>Insurance themes shaped by law, markets, and global risk.</h2>
            </div>
            <a class="text-link" href="/articles/">View all articles â†’</a>
          </div>
          <div class="interest-grid">
            {areas.map(([icon, title, text]) => (
              <article class="interest-item">
                <div class="interest-icon" aria-hidden="true">{icon}</div>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section__head">
            <div>
              <p class="eyebrow">Latest perspectives</p>
              <h2>Current article and upcoming perspectives.</h2>
            </div>
            <a class="text-link" href="/articles/">View all articles â†’</a>
          </div>
          <div class="article-grid">
          {featured && (
              <a class="article-card" href={`/articles/${featured.id}/`}>
                <img src={featured.data.featuredImage ?? '/assets/article-whose-law-card.webp'} alt="" />
                <div class="article-card__body">
                  <p class="eyebrow">{featured.data.category}</p>
                  <h3>{featured.data.title}</h3>
                  {featured.data.description && <p>{featured.data.description}</p>}
                  <div class="meta-row">
                    <span>{readTime(featured)}</span>
                    <span>{formatDate(featured.data.date)}</span>
                    <span>â†’</span>
                  </div>
                </div>
              </a>
            )}
            {comingSoon.map((item) => (
              <article class="article-card article-card--soon" aria-label={`${item.title} coming soon`}>
                <img src={item.image} alt="" />
                <div class="article-card__body">
                  <p class="eyebrow">{item.category}</p>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <div class="meta-row">
                    <span>{item.date}</span>
                    <span>In preparation</span>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--navy" id="about">
        <div class="container about-band">
          <div class="about-portrait">
            <img src="/assets/headshot.jpg" alt="Portrait of Manoj Teja Yadlapati" />
          </div>
          <div class="about-copy">
            <p class="eyebrow">About Manoj Teja Yadlapati</p>
            <div class="about-rule" aria-hidden="true"></div>
            <p class="about-kicker">Editorial focus</p>
