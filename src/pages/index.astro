---
import '../styles/global.css';
import '../styles/image-overrides.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = articles.find((article) => article.id === 'whose-law-which-court') ?? articles[0];
const comingSoon = [
  {
    title: 'Letters of Credit – Bridges of Global Trust',
    description: 'Understanding the legal architecture behind trade finance.',
    category: 'Insurance Wordings',
    image: '/assets/article-marine-card.webp',
  },
];

const areas = [
  ['◎', 'Large Multinational Corporate Accounts', 'Cross-border programmes, fronting considerations, and complex account servicing.'],
  ['♢', 'Liability Lines', 'Commercial liability, casualty exposure, defence strategy, and claims pathways.'],
  ['♙', 'Professional Indemnity', 'PI disputes, claims-made pressure points, and advisory-risk wording issues.'],
  ['▤', 'Insurance Wordings', 'Policy language, exclusions, jurisdiction clauses, and coverage alignment.'],
  ['✦', 'Specialty Lines', 'Cyber, financial lines, niche placements, and emerging risk transfer.'],
  ['▥', 'Property Insurance', 'Property programme structure, catastrophe exposure, and business interruption themes.'],
  ['◉', 'Geopolitical Risk & Insurance', 'Trade disruption, sanctions context, political volatility, and territorial risk.'],
  ['◇', 'Cross-Border Disputes', 'Forum, law, enforcement and insurance response across jurisdictions.'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manoj Teja Yadlapati | Cross-border Insurance Perspectives</title>
    <meta name="description" content="Independent perspectives on insurance wordings, complex claims, jurisdictional risk, and the commercial forces shaping global risk transfer." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Manoj Teja Yadlapati | Cross-border Insurance Perspectives" />
    <meta property="og:description" content="Insurance, liability, and cross-border risk perspectives from Dubai to global markets." />
    <meta property="og:image" content="/assets/site-hero-main.webp" />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <SiteHeader />
    <main>
      <section class="hero">
        <div class="hero__inner">
          <div class="hero__copy">
            <p class="eyebrow">Cross-border insurance perspectives</p>
            <h1>Insurance, liability, and cross-border risk — from <em>Dubai to global markets.</em></h1>
            <div class="hero__line"></div>
            <p class="hero__lede">Independent perspectives on insurance wordings, complex claims, jurisdictional risk, and the commercial forces shaping global risk transfer.</p>
            <div class="hero__actions">
              <a class="button button--gold" href="/articles/">Explore latest perspectives →</a>
              <a class="button button--line" href="/podcasts/">Listen to podcast →</a>
            </div>
          </div>
        </div>
      </section>

      {featured && (
        <section class="section">
          <div class="container featured-publication">
            <div class="featured-publication__copy">
              <p class="eyebrow">Featured publication</p>
              <h2>{featured.data.title}</h2>
              {featured.data.description && <p>{featured.data.description}</p>}
              <p>A practical lens on law, forum, enforcement, and insurance response in cross-border commercial and insurance disputes.</p>
              <div class="featured-publication__actions">
                <a class="button button--dark" href={`/articles/${featured.id}/`}>Read article</a>
                {featured.data.audio && <a class="button button--ghost" href={`/articles/${featured.id}/#audio`}>Listen to podcast ▶</a>}
              </div>
            </div>
            <a class="feature-image" href={`/articles/${featured.id}/`} aria-label={`Read ${featured.data.title}`}>
              <img src={featured.data.featuredImage ?? '/assets/article-whose-law-card.webp'} alt="" />
            </a>
          </div>
        </section>
      )}

      <section class="section" id="areas">
        <div class="container">
          <div class="section__head">
            <div>
              <p class="eyebrow">Areas of interest</p>
              <h2>Insurance themes shaped by law, markets, and global risk.</h2>
            </div>
            <a class="text-link" href="/articles/">View all articles →</a>
          </div>
          <div class="interest-grid">
            {areas.map(([icon, title, text]) => (
              <article class="interest-item">
                <div class="interest-icon" aria-hidden="true">{icon}</div>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section__head">
            <div>
              <p class="eyebrow">Latest perspectives</p>
              <h2>Current article and upcoming perspectives.</h2>
            </div>
            <a class="text-link" href="/articles/">View all articles →</a>
          </div>
          <div class="article-grid">
            {featured && <ArticleCard article={featured} variant="grid" />}
            {comingSoon.map((item) => <ArticleCard item={item} variant="grid" comingSoon />)}
          </div>
        </div>
      </section>

      <section class="section section--navy" id="about">
        <div class="container about-band">
          <img src="/assets/headshot.jpg" alt="Portrait of Manoj Teja Yadlapati" />
          <div class="about-copy">
            <p class="eyebrow">About Manoj Teja Yadlapati</p>
            <p class="about-kicker">Editorial focus</p>
            <h2>Practical insurance perspectives across liability, wordings, and cross-border risk.</h2>
            <p>Independent perspectives for serious insurance readers, shaped by commercial context and practical market experience.</p>
            <a class="button button--line" href="/articles/">Read the articles →</a>
          </div>
          <div class="about-principle">
            <div class="interest-icon">◎</div>
            <h3>Global Perspective</h3>
            <p>Insights shaped by international exposure and cross-border commercial realities.</p>
          </div>
          <div class="about-principle">
            <div class="interest-icon">♢</div>
            <h3>Practical Insight</h3>
            <p>Connecting legal, insurance, and commercial considerations that truly matter.</p>
          </div>
          <div class="about-principle">
            <div class="interest-icon">✎</div>
            <h3>Independent Thinking</h3>
            <p>Unbiased perspectives on emerging risks and evolving jurisdictions.</p>
          </div>
          <blockquote class="quote-card">Complex risks demand clarity, context, and the right perspective.<span>— Manoj Teja Yadlapati</span></blockquote>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="container two-column">
          <div>
            <p class="eyebrow">Contact</p>
            <h2>Publishing, speaking, and professional conversations.</h2>
            <p style="margin-top: 14px; color: var(--paper-muted); max-width: 680px;">For article collaborations, podcast conversations, or professional dialogue around liability, wordings, specialty lines, and cross-border risk, connect through LinkedIn or email.</p>
          </div>
          <div class="contact-actions">
            <a class="button button--dark" href="https://www.linkedin.com/in/yadlapati/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <details class="contact-drawer">
              <summary class="button button--ghost">Email Manoj</summary>
              <form name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
                <input type="hidden" name="form-name" value="contact" />
                <input type="hidden" name="subject" value="Message from Manoj Teja website" />
                <p class="hidden-field">
                  <label>Leave this field blank <input name="bot-field" /></label>
                </p>
                <label>
                  Name
                  <input type="text" name="name" autocomplete="name" required />
                </label>
                <label>
                  Email address
                  <input type="email" name="email" autocomplete="email" required />
                </label>
                <label>
                  Message
                  <textarea name="message" rows="5" required></textarea>
                </label>
                <button class="button button--dark" type="submit">Send message</button>
              </form>
            </details>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
