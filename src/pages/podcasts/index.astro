---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const episodes = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.audio)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Podcast | Manoj Teja</title>
    <meta name="description" content="Audio perspectives on insurance, liability, wordings and cross-border risk." />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </head>
  <body class="insights-page">
    <SiteHeader />
    <main class="insights-wrap">
      <div class="insights-header">
        <div>
          <p class="eyebrow">Podcast</p>
          <h1>Audio perspectives for article readers.</h1>
          <p style="margin-top: 12px; color: var(--paper-muted); max-width: 700px;">Selected articles include an audio perspective for listeners who prefer to absorb complex insurance themes while travelling or between meetings.</p>
        </div>
        <a class="text-link" href="/articles/">View articles →</a>
      </div>
      <section class="insight-list">
        {episodes.map((episode) => <ArticleCard article={episode} href={`/articles/${episode.id}/#audio`} variant="row" metaLabel="Audio perspective" actionLabel="▶" />)}
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
